# Copy to .env and adjust.
APP_ENV=development            # development | test | production
DEBUG=true                     # in development, OTP codes are printed to the console and returned in API responses

# SQLite for quick local dev. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://lishebora:lishebora@localhost:5432/lishebora
DATABASE_URL=sqlite:///./lishebora.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000

# Cookies: set COOKIE_SECURE=true behind HTTPS
COOKIE_SECURE=false

STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# First super administrator (created by `python -m app.seed.run`)
SEED_ADMIN_EMAIL=admin@lishebora.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# Password for demo users created by `python -m app.seed.run --demo` (development only)
SEED_DEMO_PASSWORD=Demo!2026pass

# Sealed bids: Fernet key (REQUIRED in production; dev derives one from JWT_SECRET).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BID_ENCRYPTION_KEY=
# Minimum evaluators who must submit scores before results can be consolidated
BID_MIN_EVALUATORS=1

# Phase 5: finance
INVOICE_PRICE_TOLERANCE_PCT=0
PAYMENT_TARGET_DAYS=30

# Phase 6
PUBLIC_SITE_URL=http://localhost:3000   # printed in batch QR labels; set to the public website address
MPESA_CALLBACK_SECRET=                  # HMAC secret shared with the M-Pesa gateway adapter; empty = callbacks disabled
