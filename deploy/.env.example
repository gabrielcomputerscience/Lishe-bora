# ---- LisheBora pilot deployment: copy to deploy/.env and fill in EVERY value ----
DOMAIN=lishebora.example.org           # public address; DNS A record must point to this server
ACME_EMAIL=ict@example.org             # for Let's Encrypt certificate notices

POSTGRES_USER=lishebora
POSTGRES_PASSWORD=                     # long random value
POSTGRES_DB=lishebora

# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP with your other secrets. Without it, unopened bids cannot be decrypted.
BID_ENCRYPTION_KEY=

SEED_ADMIN_EMAIL=admin@example.org     # first super administrator (MFA by email/SMS)
SEED_ADMIN_PASSWORD=                   # strong temporary password; change after first sign-in

# SMS (Africa's Talking). Keep AT_SANDBOX=true until the sender ID is approved.
NOTIFY_BACKEND=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

# Email (any SMTP relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LisheBora <no-reply@example.org>

# Programme settings
PAYMENT_TARGET_DAYS=30
INVOICE_PRICE_TOLERANCE_PCT=0
MPESA_CALLBACK_SECRET=                 # only when an M-Pesa gateway adapter is contracted
WEB_WORKERS=2
